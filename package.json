{
  "name": "portfolio-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack personal portfolio application with React, Vite, Express, and MongoDB",
  "scripts": {
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "dev": "concurrently -n \"CLIENT,SERVER\" -c \"cyan,magenta\" \"npm run dev:client\" \"npm run dev:server\"",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "build": "npm run build:client",
    "test:client": "npm --prefix client run test",
    "test:server": "npm --prefix server run test",
    "test": "npm run test:server && npm run test:client",
    "start": "npm --prefix server start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
